# ---------------------------------------------------------------------------
# 饿师傅的技术札记 — environment template
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# ---------------------------------------------------------------------------

# development | production
NODE_ENV=development

# HTTP port used by the Node/Express server
PORT=3000

# Address the Node server listens on. Keep 127.0.0.1 behind Nginx or in local
# development. The official Docker image sets this to 0.0.0.0 inside the
# container so the published port can reach it.
HOST=127.0.0.1

# Public origin of the site. Used for CSRF origin checks, canonical URLs,
# sitemap.xml and SEO push. No trailing slash. In dev this is the Vite origin.
SITE_URL=http://localhost:5173

# REQUIRED: long random secret (>= 32 chars) used for session/challenge signing
# and TOTP secret encryption. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Keep this value stable after deployment: changing it invalidates sessions and
# makes existing TOTP secrets undecryptable.
APP_SECRET=

# Set to true when the site is served over HTTPS (production).
COOKIE_SECURE=false

# Set to 1 only when running behind a trusted reverse proxy (Nginx, etc.).
TRUST_PROXY=0

# Optional absolute paths. Empty = <project>/data/blog.db and <project>/uploads.
DB_PATH=
UPLOAD_DIR=

# Optional. Comma-separated extra origins allowed to send write requests.
# SITE_URL is always allowed. Example: https://www.example.com
ALLOWED_ORIGINS=

# Optional non-interactive admin bootstrap. If omitted, `pnpm setup` prompts.
# ADMIN_USERNAME=
# ADMIN_PASSWORD=
